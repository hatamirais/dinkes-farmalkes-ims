{
  "name": "dinkes-farmalkes-ims-playwright-local",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "css:watch": "bunx --no-install tailwindcss -i backend/static_src/css/app.css -o backend/static/css/app.tailwind.css --watch=always",
    "css:build": "bunx --no-install tailwindcss -i backend/static_src/css/app.css -o backend/static/css/app.tailwind.css --minify",
    "css:check": "node scripts/css/check.mjs",
    "playwright:install": "bunx --no-install playwright install chromium",
    "playwright:auth": "bun scripts/playwright/run-helper.mjs auth",
    "playwright:refresh-auth": "bun scripts/playwright/run-helper.mjs refresh-auth",
    "playwright:open": "bun scripts/playwright/run-helper.mjs open",
    "playwright:test": "bunx --no-install playwright test",
    "playwright:bootstrap": "bun run playwright:install && bun run playwright:auth"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "playwright": "^1.54.2",
    "tailwindcss": "4.3.3"
  }
}
